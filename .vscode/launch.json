{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ice-lab (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/ice-lab",
            "args": [""],
            "stopAtEntry": false,
            "preLaunchTask": "cmake build debug",
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug ice-lab (Profile)",
